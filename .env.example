# Ambiente
NODE_ENV=development

# API
API_PORT=3001
# API_BASE_URL é derivada automaticamente como http://localhost:${API_PORT}.
# Defina apenas se precisar de uma URL diferente (ex: Codespaces, produção).
# API_BASE_URL=https://meu-dominio.com

# Frontend
WEB_PORT=5174
# WEB_BASE_URL segue a mesma lógica de API_BASE_URL.
# WEB_BASE_URL=https://meu-dominio.com

# PostgreSQL local via Docker Compose
POSTGRES_DB=appstart
POSTGRES_USER=appstart
POSTGRES_PASSWORD=appstart_dev_password_change_me
POSTGRES_PORT=5433
# Prisma / conexão com banco da aplicação
DATABASE_URL=postgresql://appstart:appstart_dev_password_change_me@localhost:5433/appstart?schema=public

# Shell responsável pela autenticação e identidade do usuário
SHELL_BASE_URL=http://localhost:3000

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API NestJS: iniciar com debug",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/api",
        "exec",
        "nest",
        "start",
        "--watch",
        "--debug",
        "9229"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "start-mfe",
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "API NestJS: anexar em 9229",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "MFE tasks: iniciar Vite",
      "type": "node-terminal",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "INICIAR API + MFE tasks",
      "configurations": [
        "API NestJS: iniciar com debug",
        "MFE tasks: iniciar Vite"
      ],
      "stopAll": true
    }
  ]
}